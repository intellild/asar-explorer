{
  "name": "asar-explorer",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev --port 3000",
    "build": "node scripts/create-demo.mjs && rsbuild build && tsc6 --noEmit && node scripts/verify-static.mjs",
    "preview": "node scripts/serve-static.mjs",
    "typecheck": "tsc6 --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-start": "^1.168.61",
    "@tanstack/react-virtual": "^3.14.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.4",
    "lucide-react": "^1.55.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.16",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@playwright/test": "^1.64.0",
    "@rsbuild/core": "^2.0.11",
    "@rsbuild/plugin-react": "^2.0.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@types/node": "25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.10",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.34.4"
}
